DATABASE_URL=jdbc:mysql://localhost:3306/pantry?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=pantry
DATABASE_PASSWORD=
PORT=8080
HIBERNATE_DDL_AUTO=update
APP_LOG_LEVEL=INFO
SPRING_JPA_SHOW_SQL=false
SERVER_ERROR_INCLUDE_MESSAGE=never
SERVER_ERROR_INCLUDE_STACKTRACE=never
PEXELS_API_KEY=
PEXELS_BACKFILL_RESERVE=25
PHOTOS_BACKFILL_ENABLED=true
PHOTOS_BACKFILL_BATCH_SIZE=40
PHOTOS_BACKFILL_INITIAL_DELAY=PT10S
PHOTOS_BACKFILL_INTERVAL=PT1H
PHOTOS_BACKFILL_NOT_FOUND_RETRY=PT720H
PHOTOS_BACKFILL_FAILURE_RETRY=PT1H
PHOTOS_BACKFILL_MAX_FAILURE_RETRY=PT24H
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=pantry-planner
JWT_AUDIENCE=pantry-planner-web
JWT_TTL=PT30M
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_LOGIN_RATE_LIMIT_WINDOW=PT1M
AUTH_REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_REGISTRATION_RATE_LIMIT_WINDOW=PT1H
AUTH_TRUSTED_CLIENT_IP_HEADER=
SEED_OWNER_PASSWORD=
SEED_USER_PASSWORD=
