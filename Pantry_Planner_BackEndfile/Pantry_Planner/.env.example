DATABASE_URL=jdbc:mysql://localhost:3306/pantry?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=pantry
DATABASE_PASSWORD=
PORT=8080
HIBERNATE_DDL_AUTO=update
APP_LOG_LEVEL=INFO
SPRING_JPA_SHOW_SQL=false
SERVER_ERROR_INCLUDE_MESSAGE=never
